# Maintainer: Adiker <40745238+Adiker@users.noreply.github.com>
_pkgname=meetoverlay
pkgname=meetoverlay-git
pkgver=0.1.0.r2
pkgrel=1
pkgdesc='Wayland overlay for Google Meet microphone status'
arch=('x86_64')
url='https://github.com/Adiker/MeetOverlay'
license=('MIT')
depends=('glibc' 'libgcc' 'libstdc++' 'qt6-base' 'qt6-declarative' 'qt6-wayland' 'layer-shell-qt')
makedepends=('cmake' 'git' 'ninja' 'python')
checkdepends=('nodejs')
provides=('meetoverlay')
conflicts=('meetoverlay')
source=("git+$url.git")
sha256sums=('SKIP')
pkgver() {
  cd MeetOverlay
  printf '0.1.0.r%s' "$(git rev-list --count HEAD)"
}
build() {
  cmake -S MeetOverlay -B build -G Ninja -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}
check() {
  ctest --test-dir build --output-on-failure
  node --test MeetOverlay/tests/*.test.mjs
}
package() {
  DESTDIR="$pkgdir" cmake --install build
  mv "$pkgdir/usr/share/licenses/meetoverlay" "$pkgdir/usr/share/licenses/$pkgname"
}
